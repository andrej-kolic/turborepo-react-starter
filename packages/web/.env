# Loaded first by every run (docs/template/env.md#which-env-files-load).
# Change a value from this file on your machine in .env.local.
NO_PREFIX="Should be excluded"
APP_REACT_TITLE="Title: Web"
APP_REACT_ENV_FILE=".env"
APP_REACT_VERSION="0.1.7"

# Keep "true": pnpm check:env-guards fails any build that drops the code this switch guards.
APP_REACT_GUARD_ON="true"
