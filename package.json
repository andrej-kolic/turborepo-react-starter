{
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "build": "dotenv -- turbo run build",
    "build:app": "dotenv -- sh -c 'turbo run build --filter \"$BUNDLER\"... \"$@\"' -- ",
    "build:ui": "dotenv -- turbo run build --filter ui-storybook...",
    "dev": "dotenv -- turbo run dev",
    "dev:app": "dotenv -- sh -c 'turbo run dev --filter \"$BUNDLER\"...'",
    "dev:ui": "dotenv -- sh -c 'turbo run dev --filter ui-storybook...'",
    "preview": "dotenv -- turbo run preview",
    "preview:app": "dotenv -- sh -c 'turbo run preview --filter \"$BUNDLER\"'",
    "preview:ui": "dotenv -- turbo run preview --filter ui-storybook",
    "lint": "dotenv -- turbo run lint",
    "lint:app": "dotenv -- sh -c 'turbo run lint --filter \"$BUNDLER\"... \"$@\"' -- ",
    "lint:ui": "dotenv -- turbo run lint --filter ui-storybook...",
    "test": "dotenv -- turbo run test",
    "test:watch": "dotenv -- turbo run test:watch",
    "e2e": "dotenv -- pnpm --filter @repo/e2e e2e",
    "check:dependencies": "dotenv -- syncpack lint --dependency-types prod,dev",
    "check:type": "dotenv -- turbo run check:type",
    "check:format": "dotenv -- prettier . --check",
    "check:agents": "pnpm rules:check && rulesync generate --check -t claudecode -f skills,commands && rulesync generate --check -t cursor -f commands,mcp",
    "check:links": "node scripts/check-links.js",
    "clear:cache": "pnpm cache delete && rm -rf pnpm-lock.yaml && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "clear:output": "turbo run clear:output",
    "format:code": "dotenv -- prettier . --write",
    "format:dependencies": "dotenv -- pnpm dlx sherif@latest -f",
    "quality-checks": "dotenv -- pnpm check:dependencies && pnpm check:agents && pnpm check:links && pnpm check:format && pnpm turbo check:type lint test",
    "deploy:aws": "dotenv -- sh -c 'pnpm build:app && ./infra/aws/scripts/deploy.sh content \"$BUILD_ENVIRONMENT\"'",
    "deploy:netlify": "dotenv -- sh -c 'pnpm build:app && pnpm run --filter @repo/infra-netlify deploy'",
    "prepare": "husky",
    "update:dependencies": "syncpack update --interactive",
    "chrome:debug": "browser-tools-chrome",
    "browser:setup": "dotenv -- dev-tools-app-target run browser-tools-setup",
    "browser:ensure-app": "dotenv -- dev-tools-app-target run node scripts/ensure-app.js",
    "browser": "dotenv -- dev-tools-app-target run browser-tools",
    "capture": "dotenv -- dev-tools-app-target run browser-capture",
    "modern-web-guidance": "dotenv -v DISABLE_TELEMETRY=1 -- modern-web-guidance",
    "sync:agents": "rulesync generate",
    "rules:install": "rulesync install && rulesync generate -f rules -t claudecode,cursor",
    "rules:outdated": "pnpm dlx github:andrej-kolic/playbook rules --check",
    "rules:update": "rulesync install --update && rulesync generate -f rules -t claudecode,cursor",
    "rules:check": "rulesync install --frozen && rulesync generate --check -f rules -t claudecode,cursor"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@repo/browser-capture": "workspace:*",
    "@repo/browser-tools": "workspace:*",
    "@repo/dev-tools": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "dotenv-cli": "11.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "modern-web-guidance": "1.0.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "rulesync": "43.7.0",
    "syncpack": "15.3.3",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "name": "turborepo-react-starter"
}
