{
  "name": "app-rspack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devPort": 8080,
  "previewPort": 8081,
  "scripts": {
    "_bundle_dev": "tsx node_modules/@rspack/cli/bin/rspack.js serve --mode development --config config/rspack.config.ts",
    "_bundle_build": "tsx node_modules/@rspack/cli/bin/rspack.js build --mode production --config config/rspack.config.ts",
    "dev": "NODE_ENV=development pnpm _bundle_dev",
    "build": "NODE_ENV=production pnpm _bundle_build",
    "preview": "tsx ./scripts/preview.ts",
    "lint": "eslint .",
    "check:type": "tsc --noEmit",
    "check:type:go": "tsgo --noEmit",
    "clear:output": "rm -rf ./dist"
  },
  "dependencies": {
    "@repo/app-core": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@repo/dev-tools": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@rspack/cli": "2.3.1",
    "@rspack/core": "2.3.1",
    "@rspack/dev-server": "2.2.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "serve": "catalog:",
    "tsx": "catalog:"
  }
}
