# Loaded only by builds with BUILD_PROFILE=features (docs/template/build-profiles.md): every optional
# feature on, with fake values, so checks and E2E tests run on it. A new optional feature adds its values here.

# Fake DSN: 32 hex characters, as Sentry's format and pnpm check:env-guards need. E2E tests answer
# every request to Sentry in the browser, so nothing is sent.
APP_REACT_SENTRY_DSN="https://00000000000000000000000000000000@o0.ingest.sentry.io/0"
# Every visit sends Web Vitals: the default 0.1 would make the web vitals E2E test flaky.
APP_REACT_SENTRY_TRACES_SAMPLE_RATE="1"
